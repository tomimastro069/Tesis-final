{
  "name": "IA - Corrección de Vulnerabilidades",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "analyze-vuln",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook (Recibe Vuln)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300],
      "webhookId": "analyze-vuln"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "prompt-assignment",
              "name": "prompt",
              "value": "=Eres un experto en ciberseguridad. Analiza la siguiente vulnerabilidad y da una sugerencia corta y técnica en español para corregirla.\\n\\nNombre: {{ $json.body.vulnerability.name }}\\nTipo: {{ $json.body.vulnerability.type }}\\nSeveridad: {{ $json.body.vulnerability.severity }}\\nDescripción: {{ $json.body.vulnerability.description }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-prompt-node",
      "name": "Preparar Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [320, 300]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "create",
        "messages": {
          "messageValues": [
            {
              "message": "={{ $json.prompt }}"
            }
          ]
        },
        "options": {}
      },
      "id": "openai-node",
      "name": "OpenAI Chat",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [540, 300],
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAi API"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "result-assignment",
              "name": "ai_suggestion",
              "value": "={{ $json.message.content }}",
              "type": "string"
            },
            {
              "id": "id-assignment",
              "name": "vuln_id",
              "value": "={{ $('Webhook (Recibe Vuln)').item.json.body.vulnerability.id }}",
              "type": "string"
            }
          ]
        },
        "options": {
          "dotNotation": false
        }
      },
      "id": "format-response-node",
      "name": "Formatear Respuesta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [760, 300]
    }
  ],
  "connections": {
    "Webhook (Recibe Vuln)": {
      "main": [
        [
          {
            "node": "Preparar Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar Prompt": {
      "main": [
        [
          {
            "node": "OpenAI Chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat": {
      "main": [
        [
          {
            "node": "Formatear Respuesta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
