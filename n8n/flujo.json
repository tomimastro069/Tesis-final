    {
      "parameters": {
        "jsCode": "// Aca podes armar un mensaje bonito con los resultados\nconst data = $input.first().json;\n\nconst mensaje = `\u2705 Escaneo completado!\n\n\uD83C\uDFAF Target: ${data.target}\n\uD83D\uDCCB Status: ${data.status}\n\uD83D\uDCDD Mensaje: ${data.message}\n\n\uD83D\uDCC4 Reporte tecnico: ${data.reporte_tecnico || 'N/A'}\n\uD83D\uDCC4 Reporte cliente: ${data.reporte_cliente || 'N/A'}`;\n\nreturn [{ json: { mensaje, ...data } }];"
      },
      "id": "7a1f2b3c-0007-4d5e-8f9a-777777777777",
      "name": "Armar Notificacion Exito",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 480]
    },
    {
      "parameters": {
        "jsCode": "// Manejar el error del pipeline\nconst data = $input.first().json;\n\nconst mensaje = `\u274C Escaneo fallido!\n\n\uD83C\uDFAF Target: ${data.target}\n\uD83D\uDEA8 Error: ${data.message}`;\n\nreturn [{ json: { mensaje, ...data } }];"
      },
      "id": "7a1f2b3c-0008-4d5e-8f9a-888888888888",
